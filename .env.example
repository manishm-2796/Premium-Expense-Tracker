# ==========================================
# BACKEND ENVIRONMENT VARIABLES (for Render)
# ==========================================
# (These will be automatically handled by render.yaml if you use Render's Blueprint deployment)

# The connection string for your PostgreSQL database
DATABASE_URL=postgresql://user:password@hostname/dbname

# The secret key for JWT authentication (generate a secure random string)
SECRET_KEY=your_super_secret_key_here


# ==========================================
# FRONTEND ENVIRONMENT VARIABLES (for Vercel)
# ==========================================
# The URL of your deployed Render backend (e.g., https://expense-tracker-backend.onrender.com)
VITE_API_URL=http://localhost:8000
